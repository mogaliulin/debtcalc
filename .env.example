# Публичный адрес сайта без слэша в конце. Из него строится адрес возврата после входа:
#   {PUBLIC_URL}/api/auth/yandex/callback
# Его нужно указать в настройках приложения на https://oauth.yandex.ru (поле Redirect URI).
# Локально: http://localhost:8080 (Docker) или http://localhost:5173 (npm run dev).
PUBLIC_URL=http://localhost:8080

# Приложение Яндекс ID: https://oauth.yandex.ru/client/new
# Доступы: «Доступ к логину, имени и фамилии, полу», «Доступ к адресу электронной почты», «Доступ к портрету пользователя»
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Случайная строка для подписи служебной cookie при входе, например: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# Пароль PostgreSQL для docker-compose
POSTGRES_PASSWORD=change-me

# Порт, на котором nginx отдаёт приложение
HTTP_PORT=8080

# ТОЛЬКО для локальной разработки: пускать без входа (фиксированный тестовый пользователь)
DEV_AUTH_BYPASS=false

# Для локального запуска без Docker (по умолчанию — PostgreSQL на localhost)
# DATABASE_URL=sqlite+aiosqlite:///./dev.db
